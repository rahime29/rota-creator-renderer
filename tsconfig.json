{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],

    "jsx": "react-jsx",

    "strict": true,
    "noImplicitAny": true,

    "moduleResolution": "Node",

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,

    "types": [
      "node"
    ],

    "baseUrl": ".",

    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },

  "include": [
    "src",
    "remotion.config.ts"
  ],

  "exclude": [
    "node_modules",
    "out"
  ]
}
